{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Bien dich file test dang mo",
      "type": "process",
      "command": "C:/msys64/ucrt64/bin/gcc.exe",
      "args": [
        "-Wall",
        "-Wextra",
        "-g",
        "-I",
        "${workspaceFolder}/MSSV1_MSSV2_mini_project_20261/task_2",
        "-o",
        "${fileDirname}/${fileBasenameNoExtension}.exe",
        "${file}",
        "${workspaceFolder}/MSSV1_MSSV2_mini_project_20261/task_2/common.c"
      ],
      "options": { "cwd": "${fileDirname}" },
      "problemMatcher": ["$gcc"],
      "presentation": { "reveal": "always", "clear": true }
    },
    {
      "label": "Bien dich va chay file test dang mo",
      "type": "process",
      "command": "${fileDirname}/${fileBasenameNoExtension}.exe",
      "options": { "cwd": "${fileDirname}" },
      "dependsOn": "Bien dich file test dang mo",
      "problemMatcher": [],
      "group": { "kind": "build", "isDefault": true },
      "presentation": { "reveal": "always", "clear": false }
    }
  ]
}
